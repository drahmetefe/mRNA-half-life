  # Scatter points for GC Content (Left Axis)
  geom_point(aes(y = GC.content.5.UTR....), color = "#1f78b4", alpha = 0.6, size = 1.5) +
  geom_smooth(aes(y = GC.content.5.UTR....), method = "lm", color = "black", se = TRUE, linetype = "solid") +
  
  # Scatter points for 5'-UTR Length (Right Axis, scaled)
  geom_point(aes(y = X5.UTR.length / max(X5.UTR.length) * max(data$GC.content.5.UTR....)), 
             color = "#e31a1c", alpha = 0.6, size = 1.5) +  
  geom_smooth(aes(y = X5.UTR.length / max(X5.UTR.length) * max(data$GC.content.5.UTR....)), 
              method = "lm", color = "black", se = TRUE, linetype = "solid") +
  
  # Labels
  labs(
    title = "Regression: 5'-UTR GC% & Length vs. Half-Life (< 25h)",
    x = "Half-Life (hours)",
    y = "5'-UTR GC Content (%)"
  ) +
  
  # Secondary y-axis for 5'-UTR Length
  scale_y_continuous(
    sec.axis = sec_axis(~ . * max(data$X5.UTR.length) / max(data$GC.content.5.UTR....), 
                        name = "5'-UTR Length (nt)")
  ) +
  
  # Display R² values LOWER for better readability
  annotate("text", x = max(data$Half_life_h) * 0.7, 
           y = max(data$GC.content.5.UTR....) * 0.5,  # Moved down
           label = paste0("GC% R² = ", gc_r2), 
           color = "black", fontface = "bold", size = 6) +
  
  annotate("text", x = max(data$Half_life_h) * 0.7, 
           y = max(data$GC.content.5.UTR....) * 0.3,  # Moved further down
           label = paste0("UTR Length R² = ", utr_r2), 
           color = "black", fontface = "bold", size = 6) +
  
  # Theme for white background
  theme_minimal(base_size = 14) +
  theme(
    panel.background = element_rect(fill = "white", color = "white"),
    plot.background = element_rect(fill = "white", color = "white"),
    legend.position = "none",
    axis.text.y.right = element_text(color = "black"),  # Right axis text in black
