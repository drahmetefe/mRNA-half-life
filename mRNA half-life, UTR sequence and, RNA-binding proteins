# Load required libraries
library(ggplot2)
library(dplyr)

# Define file path
file_path <- "/Users/Ahmet/Desktop/human_mRNA_dataset.csv"

# Load dataset
data <- read.csv(file_path, header = TRUE, stringsAsFactors = FALSE)

# Ensure required columns exist
if (!all(c("X5.UTR.length", "GC.content.5.UTR....", "Half_life_h") %in% colnames(data))) {
  stop("Dataset must contain the columns: 'X5.UTR.length', 'GC.content.5.UTR....', and 'Half_life_h'")
}

# Convert Half-Life to numeric
data$Half_life_h <- as.numeric(data$Half_life_h)

# ---- Exclude Cluster 4b and Half-Life values ≥ 25 hours ----
data <- data %>%
  filter(Half_life_h < 25)  # Keep only Half-Life < 25 hours

if ("Cluster" %in% colnames(data)) {
  data <- data[data$Cluster != "4b", ]  # Remove Cluster 4b
}

# Remove NaN, Inf values
data <- data[is.finite(data$GC.content.5.UTR....) & is.finite(data$X5.UTR.length), ]

# ---- Calculate R² values ----
gc_lm <- lm(GC.content.5.UTR.... ~ Half_life_h, data = data)
utr_lm <- lm(X5.UTR.length ~ Half_life_h, data = data)

gc_r2 <- round(summary(gc_lm)$r.squared, 3)
utr_r2 <- round(summary(utr_lm)$r.squared, 3)

