# -------- GLOBAL CLUSTER COLOR PALETTE --------
global_palette <- c(
  "Cluster 1" = "#56B4E9",  # Sky Blue
  "Cluster 2" = "#009E73",  # Bluish Green
  "Cluster 3" = "#E69F00",  # Orange
  "Cluster 4" = "#CC79A7"   # Reddish Purple
)

# -------- FUNCTION TO GENERATE CLUSTER-COLORED PLOT --------
generate_cluster_plot <- function(data_vector, k, db_name, output_path) {
  df <- data.frame(HalfLife = data_vector)
  set.seed(42)
  km <- kmeans(df$HalfLife, centers = k, nstart = 25)
  df$RawCluster <- km$cluster

  # Order clusters by mean half-life
  cluster_means <- df %>%
    group_by(RawCluster) %>%
    summarise(Mean = mean(HalfLife), .groups = "drop") %>%
    arrange(Mean) %>%
    mutate(SortedCluster = paste0("Cluster ", row_number()))

  # Reassign cluster labels by sorted order
  cluster_map <- setNames(cluster_means$SortedCluster, cluster_means$RawCluster)
  df$Cluster <- cluster_map[as.character(df$RawCluster)]

  # Compute cluster statistics for legend
  stats <- df %>%
    group_by(Cluster) %>%
    summarise(
      Mean = round(mean(HalfLife), 2),
      Min = round(min(HalfLife), 2),
      Max = round(max(HalfLife), 2),
      .groups = "drop"
    ) %>%
    arrange(Cluster) %>%
    mutate(Label = paste0(Cluster, "\nMean: ", Mean, "h\nMin: ", Min, "\nMax: ", Max))

  # Final plot
  p <- ggplot(df, aes(x = HalfLife, fill = Cluster)) +
    geom_density(alpha = 0.4, color = "black") +
    scale_fill_manual(values = global_palette, labels = stats$Label, drop = FALSE) +
    labs(
      title = paste("Gaussian Distribution of mRNA Half-Life (", db_name, ")", sep = ""),
      x = "mRNA Half-Life (h)", y = "Density"
    ) +
    theme_minimal(base_size = 14) +
    theme(
      legend.position = "bottom",
      legend.title = element_blank(),
      legend.text = element_text(size = 11),
      plot.title = element_text(hjust = 0.5, face = "bold"),
      panel.background = element_rect(fill = "white"),
      plot.background = element_rect(fill = "white")
    )

  # Add vertical mean lines
  for (i in 1:nrow(stats)) {
    p <- p + geom_vline(xintercept = stats$Mean[i], color = global_palette[stats$Cluster[i]], size = 1)
  }

  # Save to file
  ggsave(output_path, plot = p, width = 8, height = 6, dpi = 300)
  cat(paste0("Saved: ", output_path, "\n"))
}

